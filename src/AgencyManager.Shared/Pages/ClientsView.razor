@inject AppDbContext Db
@inject AppState State
@inject IJSRuntime JS

<div class="content-card">
    <div class="card-header-bar">
        <div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <h3 style="margin: 0;">دفتر حسابات العملاء والذمم المالية</h3>
            </div>
            <p style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">
                متابعة أرصدة العملاء، قيمة المشاريع، المدفوعات المسجلة، والمتبقي المستحق بالشيكل ₪
            </p>
        </div>
        <div style="display: flex; gap: 8px;">
            <button class="btn btn-secondary btn-sm" @onclick="OpenNewClientModal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>إضافة عميل</span>
            </button>
            <button class="btn btn-primary btn-sm" @onclick="OpenNewPaymentModal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
                <span>تسجيل سند قبض</span>
            </button>
        </div>
    </div>

    <!-- جدول ملخص العملاء والديون -->
    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>اسم العميل والشركة</th>
                    <th>معلومات الاتصال</th>
                    <th>إجمالي قيمة العقود (₪)</th>
                    <th>المدفوع حتى اللحظة (₪)</th>
                    <th>المتبقي المستحق (₪)</th>
                    <th>حالة الحساب</th>
                    <th style="min-width: 110px;">الإجراء</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in Clients)
                {
                    var isSettled = client.BalanceDue <= 0;
                    <tr>
                        <td>
                            <strong style="font-size: 13.5px; color: var(--text-primary);">@client.FullName</strong>
                            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                @client.CompanyName
                            </div>
                        </td>
                        <td>
                            <div class="dir-ltr font-mono" style="font-size: 12px; color: var(--text-secondary);">@client.Phone</div>
                            <div class="dir-ltr font-mono" style="font-size: 11px; color: var(--text-muted);">@client.Email</div>
                        </td>
                        <td>
                            <strong style="font-size: 13.5px;" class="dir-ltr font-mono">@CurrencyHelper.FormatIls(client.TotalAgreedDeals)</strong>
                            <div style="font-size: 10.5px; color: var(--text-muted);">@client.Contracts.Count عقود</div>
                        </td>
                        <td style="color: var(--status-success); font-weight: 700; font-size: 13.5px;">
                            <span class="dir-ltr font-mono">@CurrencyHelper.FormatIls(client.TotalPaid)</span>
                            <div style="font-size: 10.5px; color: var(--text-muted);">@client.Payments.Count دفعات</div>
                        </td>
                        <td>
                            @if (!isSettled)
                            {
                                <span class="badge badge-yellow" style="font-size: 12px; font-weight: 800;">
                                    @CurrencyHelper.FormatIls(client.BalanceDue)
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-green" style="font-size: 11.5px;">
                                    مسدد بالكامل (0 ₪)
                                </span>
                            }
                        </td>
                        <td>
                            @if (!isSettled)
                            {
                                <span style="color: var(--accent-yellow-dark); font-weight: 700; font-size: 11.5px;">رصيد معلق</span>
                            }
                            else
                            {
                                <span style="color: var(--status-success); font-weight: 700; font-size: 11.5px;">لا توجد ديون</span>
                            }
                        </td>
                        <td>
                            <!-- زر هادئ متزن يراعي حالة الحساب -->
                            <button class="btn btn-secondary btn-xs" @onclick="@(() => OpenPaymentForClient(client))">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>@(isSettled ? "سند إضافي" : "سند قبض")</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- سجل آخر سندات القبض والدفعات -->
<div class="content-card">
    <div class="card-header-bar">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <h3 style="margin: 0;">آخر سندات القبض والدفعات المسجلة</h3>
            </div>
            <span class="badge badge-gray" style="font-weight: 700;">
                إجمالي المقبوضات: @CurrencyHelper.FormatIls(Payments.Sum(p => p.Amount))
            </span>
        </div>
        <button class="btn btn-secondary btn-sm" @onclick="OpenNewPaymentModal">
            + سند جديد
        </button>
    </div>
    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>تاريخ الدفعة</th>
                    <th>العميل</th>
                    <th>المبلغ المدفوع (₪)</th>
                    <th>طريقة الدفع</th>
                    <th>الرقم المرجعي (شيك / إشعار)</th>
                    <th>ملاحظات</th>
                    <th>الحالة</th>
                    <th>إشعار واتساب</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Payments)
                {
                    <tr>
                        <td>
                            <span class="dir-ltr font-mono" style="font-size: 12px;">@payment.PaymentDate.ToString("yyyy/MM/dd")</span>
                        </td>
                        <td>
                            <strong>@(payment.Client?.FullName ?? "-")</strong>
                            <div style="font-size: 10.5px; color: var(--text-muted);">@(payment.Client?.CompanyName)</div>
                        </td>
                        <td>
                            <strong style="color: var(--primary-blue); font-size: 13.5px;" class="dir-ltr font-mono">
                                @CurrencyHelper.FormatIls(payment.Amount)
                            </strong>
                        </td>
                        <td>
                            <span class="badge badge-gray">
                                @payment.Method.ToArabic()
                            </span>
                        </td>
                        <td>
                            <span class="dir-ltr font-mono" style="font-size: 11.5px; background: var(--bg-surface); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--border-color);">
                                @(string.IsNullOrEmpty(payment.ReferenceNumber) ? "-" : payment.ReferenceNumber)
                            </span>
                        </td>
                        <td style="font-size: 12px; color: var(--text-muted);">
                            @(string.IsNullOrEmpty(payment.Notes) ? "-" : payment.Notes)
                        </td>
                        <td>
                            <span class="badge badge-green">مؤكدة</span>
                        </td>
                        <td>
                            <button class="btn btn-secondary btn-xs" style="color: var(--status-success); border-color: rgba(22, 163, 74, 0.3);" title="إرسال إشعار استلام دفعة عبر واتساب" @onclick="@(() => SendWhatsAppReceipt(payment))">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                                </svg>
                                <span>واتساب</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- مودال إضافة عميل جديد -->
@if (ShowClientModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>إضافة عميل جديد للنظام</h3>
                <button class="btn btn-ghost btn-sm" @onclick="CloseModals">✕</button>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label>الاسم الكامل للمسؤول</label>
                    <input class="form-control" placeholder="مثال: م. أحمد الخالد" @bind="NewClient.FullName" />
                </div>
                <div class="form-group">
                    <label>اسم الشركة أو المحل</label>
                    <input class="form-control" placeholder="مثال: شركة القدس للاستثمار" @bind="NewClient.CompanyName" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>رقم الهاتف</label>
                    <input class="form-control dir-ltr" placeholder="059-..." @bind="NewClient.Phone" />
                </div>
                <div class="form-group">
                    <label>البريد الإلكتروني</label>
                    <input class="form-control dir-ltr" placeholder="client@domain.com" @bind="NewClient.Email" />
                </div>
            </div>

            <div class="form-group">
                <label>العنوان والمدينة</label>
                <input class="form-control" placeholder="مثال: رام الله - شارع الإرسال" @bind="NewClient.Address" />
            </div>

            <div class="form-group">
                <label>ملاحظات إضافية (تفضيل طرق الدفع أو التعامل)</label>
                <textarea class="form-control" rows="2" @bind="NewClient.Notes"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
                <button class="btn btn-secondary" @onclick="CloseModals">إلغاء</button>
                <button class="btn btn-primary" @onclick="SaveClient">حفظ العميل</button>
            </div>
        </div>
    </div>
}

<!-- مودال تسجيل سند قبض / دفعة جديدة -->
@if (ShowPaymentModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>تسجيل سند قبض / استلام دفعة مالية</h3>
                <button class="btn btn-ghost btn-sm" @onclick="CloseModals">✕</button>
            </div>

            <div class="form-group">
                <label>العميل دافع المبلغ</label>
                <select class="form-control" @bind="NewPayment.ClientId">
                    @foreach (var c in Clients)
                    {
                        <option value="@c.Id">@c.FullName (@c.CompanyName) - المتبقي: @CurrencyHelper.FormatIls(c.BalanceDue)</option>
                    }
                </select>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>المبلغ المستلم بالشيكل (₪)</label>
                    <input type="number" step="50" class="form-control" @bind="NewPayment.Amount" />
                </div>
                <div class="form-group">
                    <label>طريقة الدفع</label>
                    <select class="form-control" @bind="NewPayment.Method">
                        <option value="@PaymentMethod.Cash">كاش (نقد)</option>
                        <option value="@PaymentMethod.BankTransfer">تحويل بنكي</option>
                        <option value="@PaymentMethod.Bit">تطبيق بت (Bit)</option>
                        <option value="@PaymentMethod.Check">شيك مصرفي</option>
                        <option value="@PaymentMethod.CreditCard">بطاقة ائتمان</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>تاريخ الاستلام</label>
                    <input type="date" class="form-control" @bind="NewPayment.PaymentDate" />
                </div>
                <div class="form-group">
                    <label>الرقم المرجعي (رقم الشيك أو رقم الحوالة)</label>
                    <input class="form-control" placeholder="مثال: شيك رقم 1042 أو إشعار Bit" @bind="NewPayment.ReferenceNumber" />
                </div>
            </div>

            <div class="form-group">
                <label>بيان السند وملاحظات</label>
                <input class="form-control" placeholder="مثال: الدفعة الثانية من مشروع المتجر الإلكتروني" @bind="NewPayment.Notes" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
                <button class="btn btn-secondary" @onclick="CloseModals">إلغاء</button>
                <button class="btn btn-primary" @onclick="SavePayment">تأكيد وقيد السند</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Client> Clients = new();
    private List<PaymentRecord> Payments = new();

    private bool ShowClientModal = false;
    private bool ShowPaymentModal = false;

    private Client NewClient = new();
    private PaymentRecord NewPayment = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        Clients = await Db.Clients
            .Include(c => c.Contracts)
            .Include(c => c.Payments)
            .OrderByDescending(c => c.CreatedAt)
            .ToListAsync();

        Payments = await Db.PaymentRecords
            .Include(p => p.Client)
            .Include(p => p.Contract)
            .OrderByDescending(p => p.PaymentDate)
            .Take(15)
            .ToListAsync();
    }

    private void OpenNewClientModal()
    {
        NewClient = new Client();
        ShowClientModal = true;
    }

    private void OpenNewPaymentModal()
    {
        NewPayment = new PaymentRecord
        {
            PaymentDate = DateTime.Now,
            Amount = 1000,
            Method = PaymentMethod.Cash,
            ClientId = Clients.FirstOrDefault()?.Id ?? Guid.Empty
        };
        ShowPaymentModal = true;
    }

    private void OpenPaymentForClient(Client client)
    {
        NewPayment = new PaymentRecord
        {
            PaymentDate = DateTime.Now,
            Amount = client.BalanceDue > 0 ? client.BalanceDue : 500,
            Method = PaymentMethod.BankTransfer,
            ClientId = client.Id
        };
        ShowPaymentModal = true;
    }

    private void CloseModals()
    {
        ShowClientModal = false;
        ShowPaymentModal = false;
    }

    private async Task SaveClient()
    {
        if (string.IsNullOrWhiteSpace(NewClient.FullName)) return;

        Db.Clients.Add(NewClient);
        await Db.SaveChangesAsync();
        CloseModals();
        await LoadDataAsync();
        State.ShowNotification($"تم إضافة العميل {NewClient.FullName} بنجاح");
    }

    private async Task SavePayment()
    {
        if (NewPayment.ClientId == Guid.Empty || NewPayment.Amount <= 0) return;

        Db.PaymentRecords.Add(NewPayment);
        await Db.SaveChangesAsync();
        CloseModals();
        await LoadDataAsync();
        State.ShowNotification($"تم قيد سند القبض بمبلغ {CurrencyHelper.FormatIls(NewPayment.Amount)} بنجاح");
    }

    private async Task SendWhatsAppReceipt(PaymentRecord payment)
    {
        if (payment.Client == null) return;
        var msg = WhatsAppService.GeneratePaymentReceiptMessage(payment.Client, payment);
        var url = WhatsAppService.CreateWhatsAppUrl(payment.Client.Phone, msg);
        await JS.InvokeVoidAsync("open", url, "_blank");
        State.ShowNotification($"جاري فتح محادثة واتساب لإرسال سند القبض لـ {payment.Client.FullName}");
    }
}
