@inject AppDbContext Db
@inject AppState State
@inject IJSRuntime JS

<div class="kpi-grid">
    <!-- إجمالي الشيكات في الخزنة -->
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">إجمالي الشيكات في الخزنة (بانتظار الصرف)</div>
            <div class="kpi-value yellow">@CurrencyHelper.FormatIls(TotalInVaultAmount)</div>
            <div class="kpi-subtext">
                <span style="font-weight: 700; color: var(--accent-yellow-dark);">@ChecksInVaultCount شيكات</span> مؤجلة في الصندوق
            </div>
        </div>
        <div class="kpi-icon-badge yellow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
        </div>
    </div>

    <!-- شيكات تستحق خلال 3 أيام -->
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">شيكات تستحق الصرف قريباً</div>
            <div class="kpi-value" style="color: var(--status-danger);">@CurrencyHelper.FormatIls(DueSoonAmount)</div>
            <div class="kpi-subtext">
                <span style="color: var(--status-danger); font-weight: 700;">حان موعد إيداعها في البنك</span>
            </div>
        </div>
        <div class="kpi-icon-badge red">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>
    </div>

    <!-- شيكات تم صرفها بنجاح -->
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">شيكات تم تحصيلها وصرفها</div>
            <div class="kpi-value" style="color: var(--status-success);">@CurrencyHelper.FormatIls(TotalClearedAmount)</div>
            <div class="kpi-subtext">
                <span style="color: var(--status-success); font-weight: 700;">أموال دخلت الحساب البنكي</span>
            </div>
        </div>
        <div class="kpi-icon-badge green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="card-header-bar">
        <div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                    <circle cx="6" cy="15" r="1"></circle>
                    <line x1="10" y1="15" x2="18" y2="15"></line>
                </svg>
                <h3 style="margin: 0;">حافظة الشيكات المصرفية المؤجلة</h3>
            </div>
            <p style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">
                متابعة تواريخ الاستحقاق والتحصيل لتفادي تأخير السيولة بالشيكل ₪
            </p>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="OpenNewCheckModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>قيد شيك جديد</span>
        </button>
    </div>

    <!-- تصفية بحالة الشيك -->
    <div class="filter-toolbar">
        <div class="filter-segments">
            <button class="btn btn-sm @(SelectedStatus == null ? "btn-primary" : "btn-secondary")" @onclick="@(() => FilterStatus(null))">
                جميع الشيكات (@Checks.Count)
            </button>
            <button class="btn btn-sm @(SelectedStatus == CheckStatus.InVault ? "btn-primary" : "btn-secondary")" @onclick="@(() => FilterStatus(CheckStatus.InVault))">
                في الخزنة (@Checks.Count(c => c.Status == CheckStatus.InVault))
            </button>
            <button class="btn btn-sm @(SelectedStatus == CheckStatus.Deposited ? "btn-primary" : "btn-secondary")" @onclick="@(() => FilterStatus(CheckStatus.Deposited))">
                مودعة بالبنك (@Checks.Count(c => c.Status == CheckStatus.Deposited))
            </button>
            <button class="btn btn-sm @(SelectedStatus == CheckStatus.Cleared ? "btn-primary" : "btn-secondary")" @onclick="@(() => FilterStatus(CheckStatus.Cleared))">
                مصروفة ومحصلة (@Checks.Count(c => c.Status == CheckStatus.Cleared))
            </button>
            <button class="btn btn-sm @(SelectedStatus == CheckStatus.Bounced ? "btn-primary" : "btn-secondary")" @onclick="@(() => FilterStatus(CheckStatus.Bounced))">
                شيكات مرتجعة (@Checks.Count(c => c.Status == CheckStatus.Bounced))
            </button>
        </div>
    </div>

    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>رقم الشيك</th>
                    <th>العميل والساحب</th>
                    <th>البنك والفرع</th>
                    <th>المبلغ (₪)</th>
                    <th>تاريخ الاستحقاق والمهلة</th>
                    <th>الحالة</th>
                    <th style="min-width: 170px;">الإجراء</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var check in FilteredChecks)
                {
                    <tr>
                        <td>
                            <strong style="font-size: 13.5px; color: var(--primary-blue);" class="dir-ltr font-mono">
                                @check.CheckNumber
                            </strong>
                            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                استلام: <span class="dir-ltr font-mono">@check.ReceivedDate.ToString("yyyy/MM/dd")</span>
                            </div>
                        </td>
                        <td>
                            <strong>@(check.Client?.FullName ?? check.DrawerName)</strong>
                            <div style="font-size: 11px; color: var(--text-muted);">
                                الساحب: @check.DrawerName
                            </div>
                        </td>
                        <td>
                            <strong>@check.BankName</strong>
                            <div style="font-size: 11px; color: var(--text-muted);">@check.BranchName</div>
                        </td>
                        <td>
                            <strong style="font-size: 14px; color: var(--text-primary);" class="dir-ltr font-mono">
                                @CurrencyHelper.FormatIls(check.Amount)
                            </strong>
                        </td>
                        <td>
                            <div style="display: flex; flex-direction: column; gap: 3px;">
                                <span class="dir-ltr font-mono" style="font-weight: 700; font-size: 12.5px;">
                                    @check.DueDate.ToString("yyyy/MM/dd")
                                </span>
                                @if (check.Status == CheckStatus.InVault)
                                {
                                    var isOverdue = check.DaysUntilDue < 0;
                                    var isUrgent = check.DaysUntilDue <= 3 && check.DaysUntilDue >= 0;
                                    <span class="badge @(isOverdue ? "badge-red" : (isUrgent ? "badge-yellow" : "badge-gray"))" style="font-size: 10.5px;">
                                        @DateHelper.FormatRelativeDays(check.DaysUntilDue)
                                    </span>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="badge @GetCheckStatusBadge(check.Status)">
                                @check.Status.ToArabic()
                            </span>
                        </td>
                        <td>
                            <div style="display: flex; gap: 6px; align-items: center;">
                                @if (check.Status == CheckStatus.InVault)
                                {
                                    <button class="btn btn-secondary btn-xs" title="تسجيل إيداع الشيك بالبنك" @onclick="@(() => UpdateCheckStatus(check, CheckStatus.Deposited))">
                                        إيداع بالبنك
                                    </button>
                                }
                                @if (check.Status == CheckStatus.Deposited || check.Status == CheckStatus.InVault)
                                {
                                    <button class="btn btn-secondary btn-xs" style="color: var(--status-success); border-color: rgba(22, 163, 74, 0.3);" title="قيد تحصيل الشيك" @onclick="@(() => ClearCheck(check))">
                                        صرف وتحصيل
                                    </button>
                                    <button class="btn btn-ghost btn-xs" style="color: var(--status-danger);" title="تسجيل شيك مرتجع" @onclick="@(() => UpdateCheckStatus(check, CheckStatus.Bounced))">
                                        مرتجع
                                    </button>
                                }
                                @if (check.Status == CheckStatus.Cleared)
                                {
                                    <span style="font-size: 11.5px; color: var(--status-success); font-weight: 600;">
                                        تم القيد بالحساب
                                    </span>
                                }
                                @if (check.Status == CheckStatus.Bounced)
                                {
                                    <button class="btn btn-secondary btn-xs" @onclick="@(() => UpdateCheckStatus(check, CheckStatus.InVault))">
                                        إعادة للخزنة
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- مودال استلام شيك جديد -->
@if (ShowModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>استلام وقيد شيك مصرفي جديد</h3>
                <button class="btn btn-ghost btn-sm" @onclick="CloseModal">✕</button>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>العميل</label>
                    <select class="form-control" @bind="NewCheck.ClientId">
                        @foreach (var c in Clients)
                        {
                            <option value="@c.Id">@c.FullName (@c.CompanyName)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>اسم صاحب الشيك / الساحب</label>
                    <input class="form-control" placeholder="اسم الموقع على الشيك" @bind="NewCheck.DrawerName" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>رقم الشيك</label>
                    <input class="form-control" placeholder="مثال: 009841" @bind="NewCheck.CheckNumber" />
                </div>
                <div class="form-group">
                    <label>المبلغ بالشيكل (₪)</label>
                    <input type="number" step="100" class="form-control" @bind="NewCheck.Amount" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>اسم البنك المسحوب عليه</label>
                    <input class="form-control" placeholder="بنك فلسطين، البنك العربي، بنك القدس..." @bind="NewCheck.BankName" />
                </div>
                <div class="form-group">
                    <label>الفرع والمدينة</label>
                    <input class="form-control" placeholder="فرع الماصيون - رام الله" @bind="NewCheck.BranchName" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>تاريخ استلام الشيك</label>
                    <input type="date" class="form-control" @bind="NewCheck.ReceivedDate" />
                </div>
                <div class="form-group">
                    <label>تاريخ استحقاق الصرف (تاريخ الشيك)</label>
                    <input type="date" class="form-control" @bind="NewCheck.DueDate" />
                </div>
            </div>

            <div class="form-group">
                <label>ملاحظات (الدفعة المقابلة أو المشروع)</label>
                <input class="form-control" placeholder="دفعة ثانية من عقد رقم CNT-..." @bind="NewCheck.Notes" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
                <button class="btn btn-secondary" @onclick="CloseModal">إلغاء</button>
                <button class="btn btn-primary" @onclick="SaveCheck">قيد الشيك في الحافظة</button>
            </div>
        </div>
    </div>
}

@code {
    private List<BankCheck> Checks = new();
    private List<Client> Clients = new();
    private CheckStatus? SelectedStatus;
    private bool ShowModal = false;
    private BankCheck NewCheck = new();

    private decimal TotalInVaultAmount => Checks.Where(c => c.Status == CheckStatus.InVault).Sum(c => c.Amount);
    private int ChecksInVaultCount => Checks.Count(c => c.Status == CheckStatus.InVault);
    private decimal DueSoonAmount => Checks.Where(c => c.IsDueSoon).Sum(c => c.Amount);
    private decimal TotalClearedAmount => Checks.Where(c => c.Status == CheckStatus.Cleared).Sum(c => c.Amount);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        Clients = await Db.Clients.OrderBy(c => c.FullName).ToListAsync();
    }

    private async Task LoadDataAsync()
    {
        Checks = await Db.BankChecks
            .Include(c => c.Client)
            .Include(c => c.Contract)
            .OrderBy(c => c.DueDate)
            .ToListAsync();
    }

    private List<BankCheck> FilteredChecks => Checks
        .Where(c => SelectedStatus == null || c.Status == SelectedStatus)
        .ToList();

    private void FilterStatus(CheckStatus? status) => SelectedStatus = status;

    private void OpenNewCheckModal()
    {
        NewCheck = new BankCheck
        {
            ReceivedDate = DateTime.Now,
            DueDate = DateTime.Now.AddDays(30),
            Amount = 2500,
            BankName = "بنك فلسطين",
            BranchName = "الفرع الرئيسي",
            ClientId = Clients.FirstOrDefault()?.Id ?? Guid.Empty
        };
        ShowModal = true;
    }

    private void CloseModal() => ShowModal = false;

    private async Task SaveCheck()
    {
        if (NewCheck.ClientId == Guid.Empty || NewCheck.Amount <= 0 || string.IsNullOrWhiteSpace(NewCheck.CheckNumber))
        {
            State.ShowNotification("يرجى إكمال رقم الشيك والعميل والمبلغ", "warning");
            return;
        }

        Db.BankChecks.Add(NewCheck);
        await Db.SaveChangesAsync();
        CloseModal();
        await LoadDataAsync();
        State.ShowNotification($"تم قيد الشيك رقم {NewCheck.CheckNumber} بمبلغ {CurrencyHelper.FormatIls(NewCheck.Amount)} بنجاح");
    }

    private async Task UpdateCheckStatus(BankCheck check, CheckStatus newStatus)
    {
        check.Status = newStatus;
        await Db.SaveChangesAsync();
        await LoadDataAsync();
        State.ShowNotification($"تم تحديث حالة الشيك إلى: {newStatus.ToArabic()}");
    }

    private async Task ClearCheck(BankCheck check)
    {
        check.Status = CheckStatus.Cleared;
        
        var payment = new PaymentRecord
        {
            ClientId = check.ClientId,
            ContractId = check.ContractId,
            Amount = check.Amount,
            Method = PaymentMethod.Check,
            PaymentDate = DateTime.Now,
            ReferenceNumber = $"شيك {check.CheckNumber} - {check.BankName}",
            Notes = "تم صرف الشيك بنجاح وقيد المبلغ في حساب العميل",
            IsConfirmed = true
        };

        Db.PaymentRecords.Add(payment);
        await Db.SaveChangesAsync();
        await LoadDataAsync();
        State.ShowNotification($"تم تحصيل الشيك وإيداع {CurrencyHelper.FormatIls(check.Amount)} في حسابات العميل رسمياً");
    }

    private string GetCheckStatusBadge(CheckStatus status) => status switch
    {
        CheckStatus.Cleared => "badge-green",
        CheckStatus.InVault => "badge-yellow",
        CheckStatus.Deposited => "badge-blue",
        CheckStatus.Bounced => "badge-red",
        _ => "badge-gray"
    };
}
