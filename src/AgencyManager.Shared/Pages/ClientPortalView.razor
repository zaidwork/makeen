@inject AppDbContext Db
@inject AppState State
@inject IJSRuntime JS

<div class="content-card">
    <div class="card-header-bar">
        <div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <h3 style="margin: 0;">بوابة متابعة العميل الحية</h3>
            </div>
            <p style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">
                الرابط والتقرير الموجه للعميل لمتابعة تقدم المشروع والمراحل المنجزة والدفعات المسجلة
            </p>
        </div>
        <div>
            <select class="form-control" style="width: 250px;" @bind="SelectedContractId">
                @foreach (var c in Contracts)
                {
                    <option value="@c.Id">@c.Title (@c.Client?.CompanyName)</option>
                }
            </select>
        </div>
    </div>

    @if (CurrentContract != null)
    {
        <div style="padding: 24px;">
            <!-- بطاقة المشروع الرئيسية -->
            <div style="background: linear-gradient(135deg, #0F172A, #1E293B); border-radius: var(--radius-md); padding: 24px; color: #FFFFFF; margin-bottom: 22px; position: relative; border-right: 4px solid var(--primary-blue);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <span class="badge badge-blue" style="font-size: 12px; margin-bottom: 8px; background: rgba(37, 99, 235, 0.2); color: #93C5FD; border-color: rgba(147, 197, 253, 0.3);">
                            رقم العقد: <span class="font-mono dir-ltr">@CurrentContract.ContractNumber</span>
                        </span>
                        <h2 style="font-size: 20px; font-weight: 800; margin: 8px 0; color: #FFFFFF;">
                            @CurrentContract.Title
                        </h2>
                        <div style="color: #94A3B8; font-size: 13px;">
                            العميل: <strong style="color: #FFFFFF;">@(CurrentContract.Client?.FullName)</strong> - @(CurrentContract.Client?.CompanyName)
                        </div>
                    </div>

                    <div style="text-align: left;">
                        <button class="btn btn-primary btn-sm" @onclick="ShareViaWhatsApp">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                            </svg>
                            <span>إرسال تقرير الإنجاز بالواتساب</span>
                        </button>
                    </div>
                </div>

                <!-- شريط التقدم الكلي للمشروع -->
                <div style="margin-top: 20px;">
                    <div style="display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; margin-bottom: 8px;">
                        <span>نسبة إنجاز المشروع الكلية</span>
                        <span style="color: #60A5FA; font-size: 15px;" class="font-mono dir-ltr">@OverallProgress%</span>
                    </div>
                    <div class="progress-track" style="height: 8px; background: rgba(255,255,255,0.12);">
                        <div class="progress-fill" style="width: @OverallProgress%; height: 100%; background: #3B82F6;"></div>
                    </div>
                </div>
            </div>

            <!-- بطاقات الأرقام والمالية والديدلاين -->
            <div class="kpi-grid" style="margin-bottom: 22px;">
                <div class="kpi-card">
                    <div class="kpi-info">
                        <div class="kpi-label">موعد التسليم المتفق عليه</div>
                        <div class="kpi-value dir-ltr font-mono" style="font-size: 19px;">@CurrentContract.DeliveryDeadline.ToString("yyyy/MM/dd")</div>
                        <div class="kpi-subtext">
                            <span>@DateHelper.FormatRelativeDays((int)(CurrentContract.DeliveryDeadline - DateTime.Now).TotalDays)</span>
                        </div>
                    </div>
                    <div class="kpi-icon-badge blue">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-info">
                        <div class="kpi-label">المبلغ المسدد من العقد</div>
                        <div class="kpi-value dir-ltr font-mono" style="font-size: 19px; color: var(--status-success);">@CurrencyHelper.FormatIls(CurrentContract.TotalPaid)</div>
                        <div class="kpi-subtext">
                            <span>من إجمالي @CurrencyHelper.FormatIls(CurrentContract.TotalAmount)</span>
                        </div>
                    </div>
                    <div class="kpi-icon-badge green">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-info">
                        <div class="kpi-label">المتبقي على العقد</div>
                        <div class="kpi-value yellow dir-ltr font-mono" style="font-size: 19px;">@CurrencyHelper.FormatIls(CurrentContract.RemainingBalance)</div>
                        <div class="kpi-subtext">
                            <span>يستحق عند مراحل التسليم القادمة</span>
                        </div>
                    </div>
                    <div class="kpi-icon-badge yellow">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- مراحل العمل والتسليمات -->
            <div style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden;">
                <div style="background: var(--bg-canvas); padding: 12px 18px; border-bottom: 1px solid var(--border-color); font-weight: 700; font-size: 13.5px; display: flex; align-items: center; gap: 8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 11 12 14 22 4"></polyline>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>
                    <span>مراحل وخطوات تنفيذ المشروع</span>
                </div>
                <div style="padding: 14px;">
                    @foreach (var task in CurrentContract.GeneratedTasks)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); margin-bottom: 8px; background: var(--bg-surface-elevated);">
                            <div>
                                <div style="font-weight: 700; font-size: 13.5px; color: var(--text-primary);">@task.Title</div>
                                <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 2px;">@task.Description</div>
                                @if (task.CurrentRevisionsCount > 0)
                                {
                                    <div style="font-size: 11px; color: var(--accent-yellow-dark); margin-top: 3px; font-weight: 600;">
                                        جولات التعديل: @task.CurrentRevisionsCount من أصل @task.MaxFreeRevisions
                                    </div>
                                }
                            </div>
                            <div style="display: flex; align-items: center; gap: 16px;">
                                <div style="width: 110px;">
                                    <div class="progress-track" style="height: 5px;">
                                        <div class="progress-fill @(task.ProgressPercentage == 100 ? "green" : "")" style="width: @task.ProgressPercentage%;"></div>
                                    </div>
                                    <div style="font-size: 11px; text-align: left; font-weight: 700; margin-top: 3px;" class="dir-ltr font-mono">
                                        @task.ProgressPercentage%
                                    </div>
                                </div>

                                <span class="badge @(task.Status == TaskItemStatus.Completed ? "badge-green" : "badge-blue")">
                                    @(task.Status == TaskItemStatus.Completed ? "تم الإنجاز" : "جاري العمل")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Contract> Contracts = new();
    private Guid? SelectedContractId;
    private Contract? CurrentContract => Contracts.FirstOrDefault(c => c.Id == SelectedContractId);

    private int OverallProgress => CurrentContract?.GeneratedTasks.Count > 0
        ? (int)Math.Round(CurrentContract.GeneratedTasks.Average(t => t.ProgressPercentage))
        : 0;

    protected override async Task OnInitializedAsync()
    {
        Contracts = await Db.Contracts
            .Include(c => c.Client)
            .Include(c => c.GeneratedTasks)
            .Include(c => c.Payments)
            .ToListAsync();

        SelectedContractId = Contracts.FirstOrDefault()?.Id;
    }

    private async Task ShareViaWhatsApp()
    {
        if (CurrentContract?.Client == null) return;
        var phone = CurrentContract.Client.Phone;
        var msg = $@"مرحباً {CurrentContract.Client.FullName}
تقرير متابعة إنجاز مشروعكم: {CurrentContract.Title}

- نسبة الإنجاز العامة: {OverallProgress}%
- موعد التسليم المتوقع: {CurrentContract.DeliveryDeadline:yyyy/MM/dd}
- الرصيد المتبقي: {CurrencyHelper.FormatIls(CurrentContract.RemainingBalance)}

شاكرين تعاونكم ومستمرون في تقديم أفضل مخرجات تليق بشركتكم.";

        var url = WhatsAppService.CreateWhatsAppUrl(phone, msg);
        await JS.InvokeVoidAsync("open", url, "_blank");
        State.ShowNotification($"جاري فتح محادثة واتساب لإرسال تقرير الإنجاز لـ {CurrentContract.Client.FullName}");
    }
}
