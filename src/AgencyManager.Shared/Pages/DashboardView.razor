@inject AppDbContext Db
@inject AppState State

<!-- شريط بطاقات الأرقام والمؤشرات المالية الرئيسية -->
<div class="kpi-grid">
    <!-- إجمالي العقود -->
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">إجمالي قيمة التعاقدات والمشاريع</div>
            <div class="kpi-value blue">@CurrencyHelper.FormatIls(TotalContractsRevenue)</div>
            <div class="kpi-subtext">
                <span style="color: var(--status-success); font-weight: 700;">@ContractsCount عقود نشطة</span> في الشركة
            </div>
        </div>
        <div class="kpi-icon-badge blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
        </div>
    </div>

    <!-- الديون المتبقية -->
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">مستحقات متبقية عند الزبائن</div>
            <div class="kpi-value yellow">@CurrencyHelper.FormatIls(PendingClientBalances)</div>
            <div class="kpi-subtext">
                <span style="color: var(--accent-yellow-dark); font-weight: 700;">@UnpaidContractsCount عقود</span> عليها أرصدة معلقة
            </div>
        </div>
        <div class="kpi-icon-badge yellow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>
    </div>

    <!-- شيكات مؤجلة في الخزنة -->
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">شيكات مؤجلة في الخزنة</div>
            <div class="kpi-value">@CurrencyHelper.FormatIls(ChecksInVaultAmount)</div>
            <div class="kpi-subtext">
                <span>@ChecksCount شيكات بانتظار تاريخ الاستحقاق</span>
            </div>
        </div>
        <div class="kpi-icon-badge blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
                <circle cx="6" cy="15" r="1"></circle>
                <line x1="10" y1="15" x2="18" y2="15"></line>
            </svg>
        </div>
    </div>

    <!-- المقبوضات الفعلية النقدية والبنكية -->
    <div class="kpi-card">
        <div class="kpi-info">
            <div class="kpi-label">المقبوضات المحصلة فعلياً</div>
            <div class="kpi-value" style="color: var(--status-success);">@CurrencyHelper.FormatIls(TotalCollectedCash)</div>
            <div class="kpi-subtext">
                <span>كاش، شيكات مصروفة، تحويل، Bit</span>
            </div>
        </div>
        <div class="kpi-icon-badge green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">
    <!-- جدول المشاريع والعقود الجارية ونسب إنجازها -->
    <div class="content-card">
        <div class="card-header-bar">
            <div style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <h3>المشاريع والعقود الجارية</h3>
            </div>
            <button class="btn btn-secondary btn-sm" @onclick="@(() => State.SetTab("Contracts"))">
                عرض كل العقود
            </button>
        </div>
        <div class="data-table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>المشروع والعقد</th>
                        <th>العميل</th>
                        <th>القيمة (₪)</th>
                        <th>المدفوع (₪)</th>
                        <th>المتبقي (₪)</th>
                        <th>حالة المشروع والتقدم</th>
                        <th>الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in ActiveContracts)
                    {
                        <tr>
                            <td>
                                <strong style="font-size: 13.5px; color: var(--text-primary);">@c.Title</strong>
                                <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                    رقم: <span style="font-family: monospace; font-weight: bold; color: var(--primary-blue);" class="dir-ltr font-mono">@c.ContractNumber</span>
                                </div>
                            </td>
                            <td>
                                <strong>@(c.Client?.FullName ?? "-")</strong>
                                <div style="font-size: 11px; color: var(--text-muted);">@(c.Client?.CompanyName)</div>
                            </td>
                            <td>
                                <strong style="font-size: 13.5px;">@CurrencyHelper.FormatIls(c.TotalAmount)</strong>
                            </td>
                            <td style="color: var(--status-success); font-weight: 700;">
                                @CurrencyHelper.FormatIls(c.TotalPaid)
                            </td>
                            <td>
                                @if (c.RemainingBalance > 0)
                                {
                                    <span class="badge badge-yellow" style="font-size: 12px; font-weight: 700;">
                                        @CurrencyHelper.FormatIls(c.RemainingBalance)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-green">مكتمل السداد</span>
                                }
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 5px; width: 130px;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px;">
                                        <span style="font-weight: 700; color: var(--text-secondary);">@c.Status.ToArabic()</span>
                                        <span style="font-weight: 700; color: var(--primary-blue);" class="dir-ltr font-mono">@(c.ProgressPercentage)%</span>
                                    </div>
                                    <div class="progress-track">
                                        <div class="progress-fill @(c.ProgressPercentage == 100 ? "green" : "")" style="width: @(c.ProgressPercentage)%"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <button class="btn btn-secondary btn-xs" @onclick="@(() => State.SetTab("Contracts"))">
                                    تفاصيل
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- الجانب الأيسر: تنبيهات استحقاق الشيكات واشتراكات البرامج -->
    <div class="content-card">
        <div class="card-header-bar">
            <h3>التنبيهات والمواعيد الحساسة</h3>
            <span class="badge badge-yellow">تنبيهات فورية</span>
        </div>
        <div style="padding: 16px;">
            <!-- تنبيه الشيكات القريبة -->
            <div style="margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--accent-yellow-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                        <line x1="2" y1="10" x2="22" y2="10"></line>
                    </svg>
                    <h4 style="font-size: 13px; font-weight: 700; color: var(--text-primary); margin: 0;">
                        شيكات تستحق الصرف قريباً
                    </h4>
                </div>
                @if (DueSoonChecks.Count == 0)
                {
                    <div style="font-size: 12px; color: var(--text-muted); padding: 10px; background: var(--bg-canvas); border-radius: 6px; border: 1px solid var(--border-color);">
                        لا توجد شيكات تستحق خلال الـ 7 أيام القادمة
                    </div>
                }
                @foreach (var chk in DueSoonChecks)
                {
                    var isOverdue = chk.DaysUntilDue < 0;
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: @(isOverdue ? "var(--status-danger-bg)" : "var(--accent-yellow-soft)"); border: 1px solid @(isOverdue ? "var(--status-danger-border)" : "var(--accent-yellow-border)"); border-radius: 8px; margin-bottom: 8px;">
                        <div>
                            <div style="font-weight: 700; font-size: 12.5px; color: var(--text-primary);">@chk.BankName - @chk.CheckNumber</div>
                            <div style="font-size: 11px; color: var(--text-muted);">الساحب: @chk.DrawerName</div>
                        </div>
                        <div style="text-align: left;">
                            <strong style="color: var(--text-primary); font-size: 13px;">@CurrencyHelper.FormatIls(chk.Amount)</strong>
                            <div style="font-size: 11px; color: @(isOverdue ? "var(--status-danger)" : "var(--accent-yellow-dark)"); font-weight: 700;">
                                @DateHelper.FormatRelativeDays(chk.DaysUntilDue)
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- تنبيه اشتراكات الأدوات -->
            <div style="border-top: 1px solid var(--border-color); padding-top: 16px;">
                <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--primary-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <h4 style="font-size: 13px; font-weight: 700; color: var(--text-primary); margin: 0;">
                        تجديد اشتراكات الأدوات والسيرفرات
                    </h4>
                </div>
                @foreach (var sub in UpcomingSubscriptions)
                {
                    var isOverdue = sub.DaysUntilRenewal < 0;
                    var isUrgent = sub.DaysUntilRenewal <= 3;
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; padding: 10px 12px; background: var(--bg-surface-elevated); border-radius: 8px; margin-bottom: 8px; border: 1px solid @(isOverdue ? "var(--status-danger-border)" : "var(--border-color)");">
                        <div>
                            <div style="font-weight: 700; color: var(--text-primary);">@sub.ServiceName</div>
                            <div style="font-size: 11px; color: var(--text-muted);">@sub.PaymentCardOrMethod</div>
                        </div>
                        <div style="text-align: left;">
                            <strong style="color: var(--primary-blue); font-size: 13px;">@CurrencyHelper.FormatIls(sub.Cost)</strong>
                            <div style="font-size: 11px; font-weight: 700; color: @(isOverdue ? "var(--status-danger)" : (isUrgent ? "var(--accent-yellow-dark)" : "var(--text-muted)"));">
                                @DateHelper.FormatRenewalDays(sub.DaysUntilRenewal)
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div style="margin-top: 16px;">
                <button class="btn btn-secondary btn-sm" style="width: 100%;" @onclick="@(() => State.SetTab("Finance"))">
                    إدارة الاشتراكات والمصاريف الكاملة
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal TotalContractsRevenue;
    private decimal PendingClientBalances;
    private decimal TotalCollectedCash;
    private decimal ChecksInVaultAmount;
    private int ContractsCount;
    private int ChecksCount;
    private int UnpaidContractsCount;

    private List<Contract> ActiveContracts = new();
    private List<BankCheck> DueSoonChecks = new();
    private List<SubscriptionItem> UpcomingSubscriptions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        TotalContractsRevenue = await Db.Contracts.SumAsync(c => (decimal?)c.TotalAmount) ?? 0;
        TotalCollectedCash = await Db.PaymentRecords.SumAsync(p => (decimal?)p.Amount) ?? 0;
        
        ChecksInVaultAmount = await Db.BankChecks
            .Where(c => c.Status == CheckStatus.InVault)
            .SumAsync(c => (decimal?)c.Amount) ?? 0;

        ContractsCount = await Db.Contracts.CountAsync();
        ChecksCount = await Db.BankChecks.CountAsync(c => c.Status == CheckStatus.InVault);

        var allContracts = await Db.Contracts
            .Include(c => c.Client)
            .Include(c => c.Payments)
            .OrderByDescending(c => c.CreatedAt)
            .ToListAsync();

        var unpaid = allContracts
            .Where(c => c.TotalAmount > c.TotalPaid)
            .ToList();
            
        UnpaidContractsCount = unpaid.Count;
        PendingClientBalances = unpaid.Sum(c => c.RemainingBalance);

        ActiveContracts = allContracts
            .Take(8)
            .ToList();

        DueSoonChecks = await Db.BankChecks
            .Where(c => c.Status == CheckStatus.InVault && c.DueDate <= DateTime.Now.AddDays(7))
            .OrderBy(c => c.DueDate)
            .Take(5)
            .ToListAsync();

        UpcomingSubscriptions = await Db.SubscriptionItems
            .Where(s => s.IsActive)
            .OrderBy(s => s.NextRenewalDate)
            .Take(5)
            .ToListAsync();
    }
}
