@inject AdminPinService PinService
@inject AppState State
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="lock-viewport">
    <div class="lock-panel">
        <!-- شعار المنظومة التنفيذي الهندسي -->
        <div class="panel-emblem">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1D4ED8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <circle cx="12" cy="11" r="2"></circle>
                <path d="M12 13v3"></path>
            </svg>
        </div>

        <h1 class="panel-heading">المنظومة الإدارية المركزية</h1>
        <p class="panel-subheading">الوصول مقصور على الإدارة العامة • جلسة مشفرة</p>

        <!-- كرت هوية المستخدم التنفيذي -->
        <div class="user-identity-strip">
            <div class="user-avatar-mark">AD</div>
            <div class="user-meta">
                <span class="user-title">المدير العام التنفيذي</span>
                <span class="user-status">صلاحيات كاملة • ₪ ILS</span>
            </div>
            <div class="status-indicator-dot" title="جاهز للدخول"></div>
        </div>

        <!-- تنبيه توضيحي للرمز الافتراضي لمنع أي التباس -->
        <div class="pin-default-hint">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>الرمز السري الافتراضي للمنظومة: <strong>123456</strong></span>
        </div>

        @if (IsError)
        {
            <div class="auth-error-alert">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>الرمز السري غير صحيح. يرجى إعادة المحاولة.</span>
            </div>
        }

        <!-- حقل إدخال الرمز السري التنفيذي المكون من 6 أرقام -->
        <div class="pin-entry-container @(IsError ? "shake" : "")" @onclick="FocusPinInput">
            <input id="agency-master-pin-input"
                   @ref="PinInputRef"
                   type="@(ShowPin ? "text" : "password")"
                   maxlength="6"
                   inputmode="numeric"
                   pattern="[0-9]*"
                   class="native-pin-input"
                   value="@EnteredPin"
                   @oninput="OnNativeInput"
                   @onkeydown="OnNativeKeyDown"
                   autocomplete="off"
                   autofocus />

            <div class="pin-digits-row">
                @for (int i = 0; i < 6; i++)
                {
                    var idx = i;
                    var isFilled = EnteredPin.Length > idx;
                    var isActive = EnteredPin.Length == idx;
                    var charValue = isFilled ? (ShowPin ? EnteredPin[idx].ToString() : "•") : "";

                    <div class="pin-cell @(isFilled ? "filled" : "") @(isActive ? "active" : "")">
                        <span class="cell-glyph">@charValue</span>
                        @if (isActive && !isFilled)
                        {
                            <span class="focus-caret"></span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="input-utility-bar">
            <button type="button" class="btn-toggle-peek" @onclick="ToggleShowPin" tabindex="-1">
                @if (ShowPin)
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                    <span>إخفاء الرمز</span>
                }
                else
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <span>إظهار الرمز</span>
                }
            </button>

            <button type="button" class="btn-toggle-touchpad" @onclick="ToggleVirtualPad" tabindex="-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                    <line x1="4" y1="10" x2="20" y2="10"></line>
                    <line x1="10" y1="4" x2="10" y2="20"></line>
                </svg>
                <span>@(ShowVirtualPad ? "إخفاء لوحة اللمس" : "لوحة أرقام شاشات اللمس")</span>
            </button>
        </div>

        @if (ShowVirtualPad)
        {
            <!-- لوحة أرقام مصغرة ومخصصة فقط لشاشات اللمس الاختيارية -->
            <div class="virtual-keypad">
                @for (int n = 1; n <= 9; n++)
                {
                    var num = n;
                    <button type="button" class="vk-btn" @onclick="@(() => AppendDigit(num.ToString()))" tabindex="-1">
                        @num
                    </button>
                }
                <button type="button" class="vk-btn vk-action" @onclick="ClearPin" tabindex="-1">C</button>
                <button type="button" class="vk-btn" @onclick="@(() => AppendDigit("0"))" tabindex="-1">0</button>
                <button type="button" class="vk-btn vk-action" @onclick="Backspace" tabindex="-1">⌫</button>
            </div>
        }

        <!-- زر الدخول المباشر للمنظومة -->
        <button type="button"
                class="btn-submit-auth @(EnteredPin.Length == 6 ? "active" : "")"
                @onclick="HandleSubmit"
                disabled="@(EnteredPin.Length != 6 || IsValidating)"
                tabindex="-1">
            @if (IsValidating)
            {
                <span class="spinner-dot"></span>
                <span>جاري التحقق وفك التشفير...</span>
            }
            else
            {
                <span>فتح لوحة التحكم التنفيذية</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            }
        </button>

        <div class="panel-security-footer">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>مشفر بنظام أمان مستقل AES-256 • غير قابل للإزالة بريست النظام</span>
        </div>
    </div>
</div>

<style>
    .lock-viewport {
        position: fixed;
        inset: 0;
        background-color: #F8FAFC;
        background-image: 
            radial-gradient(at 0% 0%, rgba(37, 99, 235, 0.05) 0px, transparent 50%),
            radial-gradient(at 100% 100%, rgba(15, 23, 42, 0.05) 0px, transparent 50%);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        user-select: none;
        padding: 20px;
    }

    .lock-panel {
        background: #FFFFFF;
        width: 100%;
        max-width: 440px;
        border-radius: 16px;
        border: 1px solid #E2E8F0;
        box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.1), 0 2px 8px rgba(0, 0, 0, 0.03);
        padding: 36px 32px;
        text-align: center;
        animation: panelFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .panel-emblem {
        width: 52px;
        height: 52px;
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

    .panel-heading {
        font-size: 21px;
        font-weight: 800;
        color: #0F172A;
        margin: 0 0 6px 0;
        letter-spacing: -0.3px;
    }

    .panel-subheading {
        font-size: 13px;
        color: #64748B;
        margin: 0 0 22px 0;
        font-weight: 500;
    }

    .user-identity-strip {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 10px 14px;
        margin-bottom: 22px;
        text-align: right;
    }

    .user-avatar-mark {
        width: 36px;
        height: 36px;
        background: #0F172A;
        color: #FFFFFF;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    .user-meta {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .user-title {
        font-size: 13px;
        font-weight: 700;
        color: #0F172A;
    }

    .user-status {
        font-size: 11px;
        color: #64748B;
        font-weight: 500;
    }

    .status-indicator-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22C55E;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
    }

    .pin-default-hint {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: #EFF6FF;
        border: 1px dashed #BFDBFE;
        border-radius: 10px;
        padding: 7px 12px;
        font-size: 12px;
        color: #1D4ED8;
        margin-bottom: 16px;
        font-weight: 600;
    }

    .auth-error-alert {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #FEF2F2;
        border: 1px solid #FECACA;
        color: #DC2626;
        font-size: 12px;
        font-weight: 600;
        padding: 8px 12px;
        border-radius: 8px;
        margin-bottom: 18px;
    }

    /* منطقة الإدخال الأنيقة */
    .pin-entry-container {
        position: relative;
        margin-bottom: 16px;
        cursor: text;
    }

    .native-pin-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: text;
        z-index: 10;
        caret-color: transparent;
    }

    .pin-digits-row {
        display: flex;
        justify-content: center;
        gap: 10px;
        direction: ltr;
    }

    .pin-cell {
        width: 48px;
        height: 56px;
        border-radius: 12px;
        border: 1.5px solid #CBD5E1;
        background: #F8FAFC;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: all 0.15s ease;
    }

    .pin-cell.active {
        border-color: #1D4ED8;
        background: #FFFFFF;
        box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);
        transform: translateY(-1px);
    }

    .pin-cell.filled {
        border-color: #1D4ED8;
        background: #FFFFFF;
    }

    .cell-glyph {
        font-size: 26px;
        font-weight: 800;
        color: #0F172A;
        font-family: monospace;
        line-height: 1;
    }

    .focus-caret {
        position: absolute;
        width: 2px;
        height: 20px;
        background: #1D4ED8;
        animation: blink 1s infinite;
    }

    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    .input-utility-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        padding: 0 4px;
    }

    .btn-toggle-peek, .btn-toggle-touchpad {
        background: none;
        border: none;
        color: #64748B;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 6px;
        border-radius: 6px;
        transition: all 0.12s ease;
    }

    .btn-toggle-peek:hover, .btn-toggle-touchpad:hover {
        color: #0F172A;
        background: #F1F5F9;
    }

    /* لوحة أرقام شاشات اللمس الاختيارية */
    .virtual-keypad {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        direction: ltr;
        margin-bottom: 20px;
        animation: panelFadeIn 0.15s ease;
    }

    .vk-btn {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        color: #0F172A;
        font-size: 18px;
        font-weight: 700;
        height: 44px;
        border-radius: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.1s ease;
    }

    .vk-btn:hover {
        background: #EFF6FF;
        border-color: #93C5FD;
        color: #1D4ED8;
    }

    .vk-btn.vk-action {
        background: #F1F5F9;
        color: #475569;
        font-size: 14px;
    }

    /* زر الدخول */
    .btn-submit-auth {
        width: 100%;
        height: 48px;
        background: #94A3B8;
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        font-size: 14.5px;
        font-weight: 700;
        cursor: not-allowed;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.15s ease;
        margin-bottom: 18px;
    }

    .btn-submit-auth.active {
        background: #2563EB;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    }

    .btn-submit-auth.active:hover {
        background: #1D4ED8;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
    }

    .panel-security-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 11.5px;
        color: #64748B;
        border-top: 1px solid #F1F5F9;
        padding-top: 14px;
    }

    .shake {
        animation: shake 0.35s ease-in-out;
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-6px); }
        40%, 80% { transform: translateX(6px); }
    }

    @@keyframes panelFadeIn {
        from { opacity: 0; transform: scale(0.98); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

@code {
    [Parameter]
    public EventCallback OnUnlocked { get; set; }

    private string EnteredPin = string.Empty;
    private bool IsError = false;
    private bool ShowPin = false;
    private bool ShowVirtualPad = false;
    private bool IsValidating = false;
    private ElementReference PinInputRef;
    private DotNetObjectReference<PinLockScreen>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("agencyInterop.setupLockInput", _dotNetRef);
            try
            {
                await PinInputRef.FocusAsync();
            }
            catch { }
        }
    }

    private void ToggleShowPin() => ShowPin = !ShowPin;
    private void ToggleVirtualPad() => ShowVirtualPad = !ShowVirtualPad;

    private async Task FocusPinInput()
    {
        try
        {
            await PinInputRef.FocusAsync();
        }
        catch { }
    }

    private async Task OnNativeInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        var digitsOnly = AdminPinService.NormalizeDigits(val);
        if (digitsOnly.Length > 6) digitsOnly = digitsOnly.Substring(0, 6);
        EnteredPin = digitsOnly;
        IsError = false;

        if (EnteredPin.Length == 6)
        {
            await ValidatePin();
        }
    }

    private async Task OnNativeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && EnteredPin.Length == 6)
        {
            await ValidatePin();
        }
        else if (e.Key == "Escape")
        {
            ClearPin();
        }
    }

    [JSInvokable]
    public async Task HandleKeyInput(string digit)
    {
        var normalized = AdminPinService.NormalizeDigits(digit);
        if (EnteredPin.Length < 6 && !string.IsNullOrEmpty(normalized))
        {
            EnteredPin += normalized;
            IsError = false;
            if (EnteredPin.Length == 6)
            {
                await ValidatePin();
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public void HandleBackspace()
    {
        Backspace();
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void HandleClear()
    {
        ClearPin();
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task HandleSubmit()
    {
        if (EnteredPin.Length == 6)
        {
            await ValidatePin();
        }
    }

    private async Task AppendDigit(string digit)
    {
        var normalized = AdminPinService.NormalizeDigits(digit);
        if (EnteredPin.Length < 6 && !string.IsNullOrEmpty(normalized))
        {
            IsError = false;
            EnteredPin += normalized;
            if (EnteredPin.Length == 6)
            {
                await ValidatePin();
            }
        }
    }

    private void Backspace()
    {
        if (EnteredPin.Length > 0)
        {
            IsError = false;
            EnteredPin = EnteredPin.Substring(0, EnteredPin.Length - 1);
        }
    }

    private void ClearPin()
    {
        EnteredPin = string.Empty;
        IsError = false;
    }

    private async Task ValidatePin()
    {
        if (IsValidating) return;

        IsValidating = true;
        await Task.Delay(100);

        if (PinService.VerifyAndUnlock(EnteredPin))
        {
            IsError = false;
            State.ShowNotification("تم التحقق بنجاح! مرحباً بالمدير العام");
            await OnUnlocked.InvokeAsync();
        }
        else
        {
            IsError = true;
            EnteredPin = string.Empty;
        }

        IsValidating = false;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("agencyInterop.removeLockInput");
            _dotNetRef?.Dispose();
        }
        catch { }
    }
}
