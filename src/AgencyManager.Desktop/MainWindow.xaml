<Window x:Class="AgencyManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:sharedLayout="clr-namespace:AgencyManager.Shared.Layout;assembly=AgencyManager.Shared"
        Title="نظام إدارة الوكالة الرقمية - لوحة الإدارة المتكاملة (Desktop Edition)" 
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>
        <blazor:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" Services="{DynamicResource services}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type sharedLayout:MainLayout}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
